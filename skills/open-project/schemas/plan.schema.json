              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "minItems": 0
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            },
            "required": [
              "id",
              "status",
              "required",
              "evidence",
              "reason"
            ],
            "additionalProperties": false
          },
          "minItems": 10
